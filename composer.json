{
    "name": "azuriom/extended-translation",
    "type": "azuriom-plugin",
    "description": "Translate news posts, pages, navbar items, and FAQ questions from the admin panel, and provide a language dropdown for themes.",
    "autoload": {
        "psr-4": {
            "Azuriom\\Plugin\\ExtendedTranslation\\": "src/"
        }
    },
    "replace": {
        "guzzlehttp/guzzle": "*",
        "guzzlehttp/promises": "*",
        "guzzlehttp/psr7": "*",
        "monolog/monolog": "*",
        "nesbot/carbon": "*",
        "psr/container": "*",
        "psr/event-dispatcher": "*",
        "psr/http-client": "*",
        "psr/http-factory": "*",
        "psr/http-message": "*",
        "psr/log": "*",
        "psr/simple-cache": "*"
    }
}